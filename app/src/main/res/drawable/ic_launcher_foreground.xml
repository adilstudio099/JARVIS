        android:strokeWidth="2.2"
        android:strokeColor="#00E5FF"
        android:strokeLineCap="round" />
    <path
        android:pathData="M27.5,47 C26.2,48.5 26.2,53.5 27.5,55"
        android:strokeWidth="3.6"
