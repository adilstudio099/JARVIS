        </aapt:attr>
    </path>

    <!-- Chrome Outer Rim Definition / Ambient Shadow Rim -->
    <path
        android:pathData="M54,51m-26,0a26,26 0 1,1 52,0a26,26 0 1,1 -52,0"
        android:strokeWidth="1.0"
        android:strokeColor="#3364748B"
        android:fillColor="#00000000" />

