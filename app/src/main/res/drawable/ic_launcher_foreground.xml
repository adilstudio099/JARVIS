    <path
        android:pathData="M50,55.5 C51.5,58.5 56.5,58.5 58,55.5"
        android:strokeWidth="2.8"
        android:strokeColor="#4000F0FF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

